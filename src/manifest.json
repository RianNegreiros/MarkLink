{
  "manifest_version": 3,
  "name": "MarkLink",
  "version": "1.5.0",
  "description": "Quickly generate links for your Markdown notes from web content.",
  "browser_specific_settings": {
    "gecko": {
      "id": "marklink@riannegreiros.com.br",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Copy as Markdown link"
  },
  "permissions": ["activeTab", "clipboardWrite", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"]
    }
  ]
}
